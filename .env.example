# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Worker only. Full database access — keep it on your Mac/server, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Worker ---
# Which providers this worker serves: comfyui, fal, or comfyui,fal
WORKER_PROVIDERS=comfyui,cloudflare
WORKER_ID=macbook

# ComfyUI Desktop listens on 8000 by default (portable/manual installs often 8188)
COMFYUI_URL=http://127.0.0.1:8000
# Exact file name from ComfyUI's models/checkpoints. Empty = first one ComfyUI reports.
COMFYUI_CHECKPOINT=

# --- Cloudflare Workers AI (free daily allowance: persona texts + fast images) ---
# dash.cloudflare.com → Workers AI → "Use REST API": copy Account ID and create a token
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Automatic quality check of every image (Llama 3.2 Vision on Cloudflare).
# Set to 1 only after reading and accepting Meta's Llama 3.2 licence + acceptable use policy:
# https://www.llama.com/llama3_2/license/  — the worker then sends the one-time "agree".
CF_VISION_LICENSE_ACCEPTED=0
QA_MAX_RETRIES=2

# fal.ai (paid, optional): https://fal.ai/dashboard/keys
FAL_KEY=
